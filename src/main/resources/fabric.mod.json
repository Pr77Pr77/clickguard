{
	"schemaVersion": 1,
	"id": "clickguard",
	"version": "${version}",
	"name": "ClickGuard",
	"description": "An auto clicker mod for Fabric that lets you automate any keybind, with smart safety features like auto-disable on damage or low health/hunger.",
	"authors": [
		"Pr77Pr77"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/clickguard",
		"sources": "https://github.com/Pr77Pr77/clickguard",
		"issues": "https://github.com/Pr77Pr77/clickguard/issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/clickguard/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"de.pr77pr77.clickguard.ClickGuard"
		],
		"client": [
			"de.pr77pr77.clickguard.client.ClickGuardClient"
		]
	},
	"mixins": [
		"clickguard.mixins.json",
		{
			"config": "clickguard.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "clickguard.accesswidener",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=${minecraft_version} <${next_major_minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}